JWT_SECRET=super_secret_key_123
JWT_EXPIRES_IN=1h
PORT=3000

# MongoDB - локальная установка
MONGODB_URI=mongodb://localhost:27017/auth_system

# MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/auth_system?retryWrites=true&w=majority

# CORS настройки (опционально)
# Для продакшена укажите конкретные домены через запятую: CORS_ORIGINS=http://localhost:3000,https://yourdomain.com
# Если не указано, разрешены все домены (только для разработки!)
# CORS_ORIGINS=*